# All keys are optional: without them the game runs on its local planner/policy.

# TypeSafe JEV — three decision streams per mech (https://typesafe.ai)
TYPESAFE_API_KEY=

# LLM commander — any OpenAI-compatible endpoint
AI_API_KEY=
AI_BASE_URL=https://api.dslab.tech/v1
# Use a fast model: plans are re-requested every few seconds.
AI_MODEL=deepseek-v4.1-flash
# AI_MAX_TOKENS=900  (raise for reasoning models)
# Extra request fields (JSON). DeepSeek v4 models get {"thinking":{"type":"disabled"}} automatically.
# AI_EXTRA_BODY=

# Proxy for the LLM commander only, e.g. http://127.0.0.1:10809
AI_PROXY=
# Route all API calls through the system proxy (default: direct keep-alive connections)
# USE_SYSTEM_PROXY=1
# PORT=8000
